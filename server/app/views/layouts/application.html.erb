<!DOCTYPE html>
<html>
  <head>
    <title>Open ESP Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= yield :head %>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <nav class="bg-blue-800 text-white px-6 py-3 flex items-center gap-6">
      <span class="font-bold text-lg"><%= link_to "Open ESP Tracker", root_path, class: "hover:underline" %></span>
      <% if logged_in? %>
        <%= link_to "Devices", devices_path, class: "hover:underline" %>
        <% if admin? %>
          <%= link_to "Admin Users", admin_users_path, class: "hover:underline" %>
          <%= link_to "Admin Devices", admin_devices_path, class: "hover:underline" %>
        <% end %>
        <span class="ml-auto text-sm"><%= current_user.email %></span>
        <%= button_to "Logout", session_path, method: :delete, class: "ml-2 bg-blue-600 hover:bg-blue-500 px-3 py-1 rounded text-sm" %>
      <% end %>
    </nav>
    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 m-4 rounded"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 m-4 rounded"><%= alert %></div>
    <% end %>
    <main class="p-6">
      <%= yield %>
    </main>
  </body>
</html>
