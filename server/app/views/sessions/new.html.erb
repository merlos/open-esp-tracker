<div class="max-w-md mx-auto bg-white rounded shadow p-8 mt-16">
  <h1 class="text-2xl font-bold mb-6">Log In</h1>
  <%= form_with url: session_path, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block font-medium mb-1" %>
      <%= f.email_field :email, class: "w-full border rounded px-3 py-2", required: true %>
    </div>
    <div class="mb-6">
      <%= f.label :password, class: "block font-medium mb-1" %>
      <%= f.password_field :password, class: "w-full border rounded px-3 py-2", required: true %>
    </div>
    <%= f.submit "Log In", class: "w-full bg-blue-700 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded" %>
  <% end %>
</div>
